---
const locations = [
  { name: 'Malibu', x: 8, y: 42, note: 'Coastal bluffs & creek trails' },
  { name: 'Topanga', x: 19, y: 30, note: 'Canyon trails & ocean overlooks' },
  { name: 'Pacific Palisades', x: 27, y: 50, note: 'Cliffside views over the PCH' },
  { name: 'San Fernando Valley', x: 44, y: 18, note: 'Wide valley trails, close to the city' },
  { name: 'Hollywood Mountains', x: 55, y: 24, note: 'City views & the Observatory' },
  { name: 'Pasadena', x: 81, y: 13, note: 'Eaton Canyon waterfalls' },
  { name: 'San Gabriel Mountains', x: 88, y: 9, note: 'High-elevation trails above the city' },
];
---
<section class="la-map-section" style="padding-top:20px;">
  <div class="retreats-page-head">
    <div class="eyebrow">Where we hike</div>
    <h2 style="color:var(--forest); font-size:clamp(1.6rem,2.8vw,2.1rem); margin-top:8px;">All over LA area &mdash; and just past it</h2>
    <p>San Gabriel Mountains, San Fernando Valley, Malibu, Topanga, Hollywood Mountains, Pasadena, and everywhere in between.</p>
  </div>

  <div class="la-map-wrap">
    <svg class="la-map-lines" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <!-- stylized SoCal coastline: Malibu -> Santa Monica Bay -> South Bay/Palos Verdes -->
      <path
        d="M3,36 C9,38 15,40 23,44 C33,50 39,56 43,64 C46,72 49,80 53,90"
        fill="none"
        stroke="var(--tiffany)"
        stroke-width="0.5"
        stroke-dasharray="1.4 1.8"
        opacity="0.6"
      />
    </svg>

    <div class="la-map-ocean-label" style="left:11%; top:64%;">PACIFIC OCEAN</div>

    {locations.map((loc) => (
      <div class="la-pin" style={`left:${loc.x}%; top:${loc.y}%;`}>
        <span class="la-pin-dot"></span>
        <div class="la-pin-label">
          <span class="la-pin-name">{loc.name}</span>
          <span class="la-pin-note">{loc.note}</span>
        </div>
      </div>
    ))}
  </div>
</section>
