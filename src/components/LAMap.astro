---
const locations = [
  { name: 'Malibu', x: 12, y: 62, note: 'Coastal bluffs & creek trails' },
  { name: 'Topanga', x: 27, y: 40, note: 'Canyon trails & ocean overlooks' },
  { name: 'Pacific Palisades', x: 20, y: 78, note: 'Cliffside views over the PCH' },
  { name: 'Griffith Park', x: 58, y: 48, note: 'City views & the Observatory' },
  { name: 'Pasadena', x: 84, y: 24, note: 'Eaton Canyon waterfalls' },
];
---
<section class="la-map-section">
  <div class="retreats-page-head">
    <div class="eyebrow">Where we hike</div>
    <h2 style="color:var(--forest); font-size:clamp(1.6rem,2.8vw,2.1rem); margin-top:8px;">All over LA &mdash; and just past it</h2>
    <p>Topanga, Malibu, the Palisades, Griffith Park, Pasadena, and everywhere in between.</p>
  </div>

  <div class="la-map-wrap">
    <svg class="la-map-lines" viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,85 C15,70 20,50 30,35 C40,20 55,15 70,20" fill="none" stroke="var(--tiffany)" stroke-width="0.4" stroke-dasharray="1.2 1.6" opacity="0.5" />
    </svg>

    {locations.map((loc) => (
      <div class="la-pin" style={`left:${loc.x}%; top:${loc.y}%;`}>
        <span class="la-pin-dot"></span>
        <div class="la-pin-label">
          <span class="la-pin-name">{loc.name}</span>
          <span class="la-pin-note">{loc.note}</span>
        </div>
      </div>
    ))}
  </div>
</section>
