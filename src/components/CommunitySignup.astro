---
---
<section class="newsletter" id="join-community">
  <div class="newsletter-inner reveal">
    <div class="eyebrow" style="justify-content:center;">Join our community</div>
    <h2>Stay in the loop</h2>
    <p>Weekly hikes, upcoming retreats, and everything happening at LAC &mdash; no spam, just the good stuff.</p>

    <!-- Saves to the database and emails team@laactivityclub.com on submit. -->
    <form id="communityForm" class="newsletter-form">
      <input type="text" name="name" placeholder="Full name" required />
      <input type="email" name="email" placeholder="Email address" required />
      <input type="tel" name="phone" placeholder="Phone number" required />
      <div class="newsletter-form-row">
        <input type="text" name="city" placeholder="City" required />
        <input type="text" name="zip" placeholder="ZIP code" inputmode="numeric" pattern="[0-9]*" required />
      </div>
      <button class="btn btn-solid" type="submit" id="communitySubmitBtn">Join the list</button>
      <p id="communityError" class="reserve-error" hidden>
        Something went wrong. Please try again in a moment.
      </p>
    </form>

    <div id="communityConfirm" class="reserve-confirm" hidden style="margin: 0 auto 20px;">
      <p>
        Thanks for signing up! You'll start hearing from us about hikes, retreats, and
        everything else happening at LAC.
      </p>
    </div>
  </div>

  <script>
    const form = document.getElementById('communityForm') as HTMLFormElement | null;
    const confirmBox = document.getElementById('communityConfirm');
    const errorBox = document.getElementById('communityError');
    const submitBtn = document.getElementById('communitySubmitBtn') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.hidden = true;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Joining...'; }

      const data = new FormData(form);
      try {
        const res = await fetch('/api/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'community',
            name: data.get('name'),
            email: data.get('email'),
            phone: data.get('phone'),
            city: data.get('city'),
            zip: data.get('zip'),
          }),
        });
        if (!res.ok) throw new Error('Signup failed');
        form.hidden = true;
        if (confirmBox) confirmBox.hidden = false;
      } catch (err) {
        console.error(err);
        if (errorBox) errorBox.hidden = false;
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Join the list'; }
      }
    });
  </script>
</section>
