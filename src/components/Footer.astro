---
const year = new Date().getFullYear();
---
<footer id="footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a href="/" class="logo" style="color:var(--sand);">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M2 19L9 7L13 14L16 9L22 19H2Z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
          <circle cx="18" cy="5" r="2.2" stroke="currentColor" stroke-width="1.4" />
        </svg>
        LA ACTIVITY CLUB
      </a>
      <p>An outdoor wellness community based in Los Angeles &mdash; weekly hikes, active retreats, and everything in between.</p>
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <h5>Explore</h5>
        <a href="/hikes">Hikes</a>
        <a href="/retreats">Retreats</a>
      </div>
      <div class="footer-col">
        <h5>Club</h5>
        <a href="/mission">Our Mission</a>
        <a href="/#join-community">Newsletter</a>
      </div>
      <div class="footer-col">
        <h5>Contact</h5>
        <a class="contact-link" href="mailto:team@laactivityclub.com">
          <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M4 6.5L12 13l8-6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          team@laactivityclub.com
        </a>
        <a class="contact-link" href="https://www.instagram.com/la_activity_club/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
          @la_activity_club
        </a>
        <a class="contact-link" href="https://chat.whatsapp.com/Imj3zAawtE29UgFYeRTPOr?s=cl&p=i&ilr=0&amv=0" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none"><path d="M12 2a10 10 0 00-8.5 15.2L2 22l4.9-1.3A10 10 0 1012 2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M8.5 8.5c-.3 1 .1 2.3 1.6 3.9 1.6 1.6 2.9 2 3.9 1.7.5-.2.9-.7 1-1.2l.1-.5-1.7-.9c-.2-.1-.4-.1-.5.1l-.4.6c-.6-.2-1.2-.6-1.7-1.1-.5-.5-.9-1.1-1.1-1.7l.6-.4c.2-.1.2-.3.1-.5l-.9-1.7-.5.1c-.5.1-1 .5-1.2 1z" fill="currentColor"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; {year} LA Activity Club. Los Angeles, CA.</span>
    <div class="footer-social">
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/terms-of-service">Terms of Service</a>
    </div>
  </div>
</footer>
