---
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-top">
    <div class="footer-brand">
      <div class="logo" style="color:var(--sand);">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M2 19L9 7L13 14L16 9L22 19H2Z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
          <circle cx="18" cy="5" r="2.2" stroke="currentColor" stroke-width="1.4" />
        </svg>
        LA ACTIVITY CLUB
      </div>
      <p>An outdoor wellness community based in Los Angeles &mdash; weekly hikes, active retreats, and everything in between.</p>
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <h5>Explore</h5>
        <a href="#split">Weekly hikes</a>
        <a href="#retreats">Retreats</a>
        <a href="#testimonial">Community</a>
      </div>
      <div class="footer-col">
        <h5>Club</h5>
        <a href="#">About</a>
        <a href="#">Journal</a>
        <a href="#newsletter">Newsletter</a>
      </div>
      <div class="footer-col">
        <h5>Contact</h5>
        <a href="mailto:hello@laactivityclub.com">hello@laactivityclub.com</a>
        <a href="https://www.instagram.com/la_activity_club/" target="_blank" rel="noopener">@la_activity_club</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; {year} LA Activity Club. Los Angeles, CA.</span>
    <div class="footer-social">
      <a href="https://www.instagram.com/la_activity_club/" target="_blank" rel="noopener">Instagram</a>
      <a href="#">Threads</a>
    </div>
  </div>
</footer>
