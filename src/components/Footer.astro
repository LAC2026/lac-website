---
const year = new Date().getFullYear();
---
<footer id="footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a href="/" class="logo" style="color:var(--sand);">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M2 19L9 7L13 14L16 9L22 19H2Z"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linejoin="round"
          />
          <circle cx="18" cy="5" r="2.2" stroke="currentColor" stroke-width="1.4" />
        </svg>
        LA ACTIVITY CLUB
      </a>
      <p>An outdoor wellness community based in Los Angeles &mdash; weekly hikes, active retreats, and everything in between.</p>
    </div>
    <div class="footer-cols">
      <div class="footer-col">
        <h5>Explore</h5>
        <a href="#split">Hikes</a>
        <a href="/retreats">Retreats</a>
      </div>
      <div class="footer-col">
        <h5>Club</h5>
        <a href="/mission">Our Mission</a>
        <a href="#newsletter">Newsletter</a>
      </div>
      <div class="footer-col">
        <h5>Contact</h5>
        <a class="contact-link" href="mailto:team@laactivityclub.com">
          <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M4 6.5L12 13l8-6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          team@laactivityclub.com
        </a>
        <a class="contact-link" href="https://www.instagram.com/la_activity_club/" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
          @la_activity_club
        </a>
        <a class="contact-link" href="https://t.me/LAActivityClub" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none"><path d="M21 4L2.5 11.3c-.9.36-.9 1.66.02 2l4.4 1.4 1.7 5.2c.24.72 1.15.93 1.68.38l2.4-2.5 4.5 3.3c.75.55 1.83.14 2.02-.77L22 4.9c.16-.75-.6-1.35-1-.9Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M7 14.7l10.5-8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          Telegram
        </a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; {year} LA Activity Club. Los Angeles, CA.</span>
  </div>
</footer>
