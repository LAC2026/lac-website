---
import { retreats } from '../data/retreats';
---
<header id="siteHeader">
  <div class="logo">
    <svg viewBox="0 0 24 24" fill="none">
      <path
        d="M2 19L9 7L13 14L16 9L22 19H2Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"
      />
      <circle cx="18" cy="5" r="2.2" stroke="currentColor" stroke-width="1.4" />
    </svg>
    LA ACTIVITY CLUB
  </div>
  <nav class="links">
    <a href="#split">Hikes</a>
    <div class="nav-dropdown">
      <a href="/retreats">
        Retreats
        <svg class="chevron" viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <div class="dropdown-panel">
        {retreats.map((r) => (
          <a href={`/retreats#${r.slug}`}>{r.name}</a>
        ))}
        <a href="/retreats" class="dropdown-viewall">View all retreats &rarr;</a>
      </div>
    </div>
    <a href="/mission">Our Mission</a>
    <a href="/#footer">Contact Us</a>
  </nav>
  <div class="nav-ctas">
    <a class="btn btn-ghost" href="https://t.me/LAActivityClub" target="_blank" rel="noopener">Join a hike</a>
    <a class="btn btn-solid" href="/retreats">View retreats</a>
  </div>
</header>
