---
import { pastTripsHistory } from '../data/retreats';

const featured = [
  {
    name: 'Yosemite',
    blurb: 'Sunrise at Tunnel View, a full day on the Mist Trail, and a group dinner under more stars than any of us see in LA.',
    image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Tunnel_View,_Yosemite_Valley,_Yosemite_NP_-_Diliff.jpg?width=900',
    imageAlt: 'Tunnel View, Yosemite Valley',
  },
  {
    name: 'Sequoia National Park',
    blurb: 'Standing under the General Sherman tree, then a quiet walk through the grove after the crowds thinned out.',
    image: 'https://commons.wikimedia.org/wiki/Special:FilePath/General_Sherman_Sequoia_Tree.jpg?width=900',
    imageAlt: 'General Sherman giant sequoia tree',
  },
  {
    name: 'Grand Canyon',
    blurb: "A sunrise rim hike, way too many photos, and a group that's stayed close ever since.",
    image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Colors_of_the_Grand_Canyon_(30569973160).jpg?width=900',
    imageAlt: 'Grand Canyon',
  },
  {
    name: 'Lake Tahoe',
    blurb: 'A crisp alpine morning at Emerald Bay, a paddle across water so clear it barely looks real, and a fire on the beach that night.',
    image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Emerald_Bay,_Lake_Tahoe,_California._2015.jpg?width=900',
    imageAlt: 'Emerald Bay, Lake Tahoe',
  },
  {
    name: 'Zion & The Narrows',
    blurb: 'Wading upstream through towering canyon walls, water at our knees the whole way, and dry socks never felt so good after.',
    image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Temple_of_Sinawava,_Zion_Canyon,_Zion_National_Park,_Utah_(1025402971).jpg?width=900',
    imageAlt: 'The Narrows trailhead, Zion National Park',
  },
  {
    name: 'Joshua Tree',
    blurb: 'A golden-hour scramble through the boulders, a campfire under more stars than any of us knew existed, and a sunset sky none of us stopped photographing.',
    image: '/images/joshua-tree-sunset.jpg',
    imageAlt: 'A Joshua tree silhouetted against a pink sunset sky',
  },
  {
    name: 'Mammoth Lakes',
    blurb: "Alpine lakes so blue they didn't look real, a hike above the tree line, and a group that never wanted to head back down.",
    image: '/images/mammoth-lakes-alpine-lake.jpg',
    imageAlt: 'A turquoise alpine lake surrounded by granite peaks near Mammoth Lakes',
  },
  {
    name: 'Sedona',
    blurb: "Red rock trails at sunset, a vortex or two we can't explain, and a group dinner with the best view in town.",
    image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Wide_View_of_Sedona_Red_Rock_Country.jpg?width=900',
    imageAlt: 'Sedona red rock country',
  },
  {
    name: 'Hawaii — Maui',
    blurb: 'Sunrise from the top of Haleakalā, an afternoon in the water, and a group that never wanted the trip to end.',
    image: 'https://commons.wikimedia.org/wiki/Special:FilePath/Maui,_Hawaii_(Unsplash).jpg?width=900',
    imageAlt: 'Maui, Hawaii coastline',
  },
];
---
<section style="padding-top:20px;">
  <div class="retreats-page-head">
    <div class="eyebrow">Where we've already been</div>
    <h2 style="color:var(--forest); font-size:clamp(1.6rem,2.8vw,2.1rem); margin-top:8px;">Past trips</h2>
    <p>A few of the retreats behind us.</p>
    <p style="margin-top:14px;">
      <a class="link" style="font-family:var(--mono); font-size:0.8rem; color:var(--tiffany); border-bottom:1px solid rgba(79,184,172,0.4); padding-bottom:3px;" href="/retreats">
        See upcoming retreats &rarr;
      </a>
    </p>
  </div>
  <div class="retreat-grid">
    {featured.map((t) => (
      <div class="retreat-card">
        <div class="photo">
          <img src={t.image} alt={t.imageAlt} />
        </div>
        <div class="retreat-card-body">
          <span class="mi">Past trip</span>
          <h4>{t.name}</h4>
          <p class="dates" style="margin-bottom:0;">{t.blurb}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<section style="padding-top:0;">
  <div class="retreats-page-head">
    <div class="eyebrow">The full history</div>
    <h2 style="color:var(--forest); font-size:clamp(1.6rem,2.8vw,2.1rem); margin-top:8px;">Every trip so far</h2>
  </div>
  <div class="trip-history">
    {pastTripsHistory.map((yearGroup) => (
      <div class="trip-history-year">
        <h3>{yearGroup.year}</h3>
        <div class="trip-tags">
          {yearGroup.trips.map((trip) => (
            <span class="trip-tag">{trip}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
