---
---
<section class="newsletter" id="newsletter">
  <div class="newsletter-inner reveal">
    <div class="eyebrow" style="justify-content:center;">Stay on the trail list</div>
    <h2>Get next week's hike in your inbox</h2>
    <p>Hike details, retreat drops, and trip recaps &mdash; nothing else.</p>

    <!--
      TODO: wire this up to a real signup endpoint + database once ready (see project roadmap).
      For now this only demonstrates the intended flow in the browser and doesn't store anything.
    -->
    <form id="newsletterForm" class="newsletter-form">
      <input type="text" name="name" placeholder="Full name" required />
      <input type="email" name="email" placeholder="Email address" required />
      <input type="tel" name="phone" placeholder="Phone number" required />
      <div class="newsletter-form-row">
        <input type="text" name="city" placeholder="City" required />
        <input type="text" name="zip" placeholder="ZIP code" inputmode="numeric" pattern="[0-9]*" required />
      </div>
      <button class="btn btn-solid" type="submit">Join the list</button>
    </form>

    <div id="newsletterConfirm" class="reserve-confirm" hidden style="margin: 0 auto 20px;">
      <p>
        Thanks for signing up! This isn't connected to a mailing list yet &mdash; once it is,
        you'll start getting next week's hike details straight to your inbox.
      </p>
    </div>
  </div>

  <script>
    const form = document.getElementById('newsletterForm') as HTMLFormElement | null;
    const confirmBox = document.getElementById('newsletterConfirm');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      form.hidden = true;
      if (confirmBox) confirmBox.hidden = false;
    });
  </script>
</section>
