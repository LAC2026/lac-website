---
---
<section class="newsletter" id="newsletter">
  <div class="newsletter-inner reveal">
    <div class="eyebrow" style="justify-content:center;">Stay on the trail list</div>
    <h2>Get next week's hike in your inbox</h2>
    <p>Hike details, retreat drops, and trip recaps &mdash; nothing else.</p>
    <!--
      TODO: wire this up to POST /api/newsletter once the signup endpoint + database exist.
      For now this is a static placeholder form (no submission handler).
    -->
    <form id="newsletterForm">
      <input type="email" name="email" placeholder="you@email.com" required />
      <button class="btn btn-solid" type="submit">Join the list</button>
    </form>
    <p class="fine">
      Hikes are always free. If a trail moved you, you're welcome to
      <a href="#">leave a trail donation</a>.
    </p>
  </div>
</section>
