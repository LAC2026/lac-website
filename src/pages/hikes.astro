---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import DonationBand from '../components/DonationBand.astro';
import LAMap from '../components/LAMap.astro';

const steps = [
  {
    title: 'Follow along',
    body: "We post this week's trail, meeting spot, and time on Instagram and Telegram — that's the only sign-up there is.",
  },
  {
    title: 'Show up',
    body: 'No membership fee, no gear checklist. Just bring water and a friend.',
  },
  {
    title: 'Hike at your own pace',
    body: 'We always have someone leading at the front and someone sweeping at the back, so no one hikes alone.',
  },
];
---
<Layout
  title="Hikes — LA Activity Club"
  description="Free hikes in and around Los Angeles, most Wednesdays and Saturdays. Follow along on Instagram or Telegram for this week's trail."
>
  <Header />

  <section class="page-hero">
    <div class="photo">
      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/Santa_monica_mountains_canyon.jpg?width=1800"
        alt="A green canyon in the Santa Monica Mountains"
      />
    </div>
    <div class="page-hero-content">
      <div class="breadcrumb"><a href="/">Home</a> / Hikes</div>
      <h1>Weekly hikes</h1>
    </div>
  </section>

  <section class="intro" style="padding-bottom:50px;">
    <div class="eyebrow">Free, most Wednesdays &amp; Saturdays</div>
    <p>
      Hikes take place in and around LA &mdash; Topanga, Malibu, Griffith Park, Pasadena, and
      more. No membership fee, no gear checklist &mdash; just show up. We post the itinerary,
      the meeting spot, and the difficulty level. Bring water, bring a friend (or make a new
      one!).
    </p>
  </section>

  <LAMap />

  <section style="padding-top:0; padding-bottom:20px;">
    <div class="retreats-page-head">
      <div class="eyebrow">How it works</div>
    </div>
    <div class="values-grid" style="grid-template-columns: repeat(3,1fr); max-width:1000px;">
      {steps.map((s, i) => (
        <div class="value-card">
          <span style="font-family:var(--mono); font-size:0.75rem; color:var(--tiffany); letter-spacing:0.08em;">STEP {i + 1}</span>
          <h3 style="margin-top:10px;">{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="retreats">
    <div class="retreats-page-head" style="color:var(--sand);">
      <div class="eyebrow" style="justify-content:center;">Where we post this week's hike</div>
      <p style="color:var(--sand-2);">Both are updated every week &mdash; follow whichever you check more often.</p>
    </div>
    <div class="connect-grid">
      <a class="connect-card" href="https://www.instagram.com/la_activity_club/" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
        <h3>Instagram</h3>
        <p>@la_activity_club &mdash; trail posts, stories, and photo recaps.</p>
        <span class="connect-cta">Follow on Instagram &rarr;</span>
      </a>
      <a class="connect-card" href="https://t.me/LAActivityClub" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none"><path d="M21 4L2.5 11.3c-.9.36-.9 1.66.02 2l4.4 1.4 1.7 5.2c.24.72 1.15.93 1.68.38l2.4-2.5 4.5 3.3c.75.55 1.83.14 2.02-.77L22 4.9c.16-.75-.6-1.35-1-.9Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M7 14.7l10.5-8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        <h3>Telegram</h3>
        <p>The fastest way to get this week's meeting spot and any last-minute changes.</p>
        <span class="connect-cta">Join the Telegram &rarr;</span>
      </a>
    </div>
  </section>

  <Newsletter />
  <DonationBand />
  <Footer />
</Layout>
