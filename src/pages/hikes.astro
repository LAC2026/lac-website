---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Newsletter from '../components/Newsletter.astro';
import DonationBand from '../components/DonationBand.astro';
import LAMap from '../components/LAMap.astro';

const steps = [
  {
    title: 'Follow along',
    body: "We post this week's trail, meeting spot, and time on Instagram and WhatsApp — that's the only sign-up there is.",
  },
  {
    title: 'Show up',
    body: 'No membership fee, no gear checklist. Just bring water and a friend.',
  },
  {
    title: 'Hike at your own pace',
    body: 'We always have someone leading at the front and someone sweeping at the back, so no one hikes alone.',
  },
];
---
<Layout
  title="Hikes — LA Activity Club"
  description="Free hikes in and around Los Angeles, most Wednesdays and Saturdays. Follow along on Instagram or WhatsApp for this week's trail."
>
  <Header />

  <section class="page-hero">
    <div class="photo">
      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/Santa_monica_mountains_canyon.jpg?width=1800"
        alt="A green canyon in the Santa Monica Mountains"
      />
    </div>
    <div class="page-hero-content">
      <div class="breadcrumb"><a href="/">Home</a> / Hikes</div>
      <h1>Weekly hikes</h1>
    </div>
  </section>

  <section class="intro" style="padding-top:50px; padding-bottom:50px;">
    <div class="eyebrow">Free, most Wednesdays &amp; Saturdays</div>
    <p>
      Hikes take place in and around LA: San Gabriel Mountains, San Fernando Valley, Malibu,
      Topanga, Hollywood Mountains, Pasadena, and more. No membership fee, no gear checklist
      &mdash; just show up. We post the itinerary, the meeting spot, and the difficulty level.
      Bring water, bring a friend (or make a new one!).
    </p>
  </section>

  <LAMap />

  <section style="padding-top:0; padding-bottom:40px;">
    <div class="retreats-page-head">
      <div class="eyebrow">How it works</div>
    </div>
    <div class="values-grid" style="grid-template-columns: repeat(3,1fr); max-width:1000px;">
      {steps.map((s, i) => (
        <div class="value-card">
          <span style="font-family:var(--mono); font-size:0.75rem; color:var(--tiffany); letter-spacing:0.08em;">STEP {i + 1}</span>
          <h3 style="margin-top:10px;">{s.title}</h3>
          <p>{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="retreats">
    <div class="retreats-page-head" style="color:var(--sand);">
      <div class="eyebrow" style="justify-content:center;">Where we post this week's hike</div>
      <p style="color:var(--sand-2);">Both are updated every week &mdash; follow whichever you check more often.</p>
    </div>
    <div class="connect-grid">
      <a class="connect-card" href="https://www.instagram.com/la_activity_club/" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/></svg>
        <h3>Instagram</h3>
        <p>@la_activity_club &mdash; trail posts, stories, and photo recaps.</p>
        <span class="connect-cta">Follow on Instagram &rarr;</span>
      </a>
      <a class="connect-card" href="https://chat.whatsapp.com/Imj3zAawtE29UgFYeRTPOr?s=cl&p=i&ilr=0&amv=0" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2a10 10 0 00-8.5 15.2L2 22l4.9-1.3A10 10 0 1012 2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M8.5 8.5c-.3 1 .1 2.3 1.6 3.9 1.6 1.6 2.9 2 3.9 1.7.5-.2.9-.7 1-1.2l.1-.5-1.7-.9c-.2-.1-.4-.1-.5.1l-.4.6c-.6-.2-1.2-.6-1.7-1.1-.5-.5-.9-1.1-1.1-1.7l.6-.4c.2-.1.2-.3.1-.5l-.9-1.7-.5.1c-.5.1-1 .5-1.2 1z" fill="currentColor"/></svg>
        <h3>WhatsApp</h3>
        <p>The fastest way to get this week's meeting spot and any last-minute changes.</p>
        <span class="connect-cta">Join the WhatsApp &rarr;</span>
      </a>
    </div>
  </section>

  <Newsletter />
  <DonationBand />
  <Footer />
</Layout>
