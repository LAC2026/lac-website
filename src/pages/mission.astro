---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommunitySignup from '../components/CommunitySignup.astro';
import { igPhotos } from '../data/retreats';

const values = [
  {
    title: 'Community first',
    body: "The hike is the excuse. The point is showing up somewhere every week where people actually know your name — and keep showing up for each other long after the trailhead.",
    icon: 'M12 21s-7-4.5-9.5-9C0.7 8.4 2 4 6 4c2 0 3.5 1.2 4 2.4C10.5 5.2 12 4 14 4c4 0 5.3 4.4 3.5 8-2.5 4.5-9.5 9-9.5 9z',
  },
  {
    title: 'Nature as medicine',
    body: 'No app, gym, or screen replaces what a few hours on a real trail does for a person. We treat time outside as essential, not optional.',
    icon: 'M12 2C8 6 5 10 5 14a7 7 0 0014 0c0-4-3-8-7-12z',
  },
  {
    title: 'Radically accessible',
    body: "Weekly hikes are, and always will be, free. Cost should never be the reason someone doesn't get to experience this.",
    icon: 'M12 3v18M7 7h6.5a2.5 2.5 0 010 5H8a2.5 2.5 0 000 5h7',
  },
  {
    title: 'Beyond the trailhead',
    body: 'For the people who want more, retreats take everything we love about a Saturday hike and stretch it into a few unforgettable days, somewhere further from home.',
    icon: 'M12 2l2.5 6.5L21 11l-6.5 2.5L12 20l-2.5-6.5L3 11l6.5-2.5L12 2z',
  },
];
---
<Layout
  title="Our Mission — LA Activity Club"
  description="Why LA Activity Club exists: free weekly hikes, real community, and active retreats for people who'd rather move outside than sit still."
>
  <Header />

  <section class="page-hero">
    <div class="photo">
      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/Colors_of_the_Grand_Canyon_(30569973160).jpg?width=1800"
        alt="Vibrant colors of the Grand Canyon"
      />
    </div>
    <div class="page-hero-content">
      <div class="breadcrumb"><a href="/">Home</a> / Our Mission</div>
      <h1>We're not your average hiking club.</h1>
    </div>
  </section>

  <section class="intro" style="padding-top:40px; padding-bottom:40px;">
    <div class="eyebrow">Our mission</div>
    <p>
      Our mission is to build a strong community of healthy, active, and open-minded people
      who inspire each other to live better, explore more, and grow together.
    </p>
    <p>
      We believe wellness is more than fitness &mdash; it's about meaningful experiences,
      genuine connections, personal growth, and being surrounded by people who share your
      energy and values.
    </p>
    <p>
      Through hikes, active trips, wellness experiences, social events, and adventures, we
      create opportunities to discover new places, make real friendships, exchange ideas,
      build valuable connections, and meet people who can become friends, collaborators, or
      partners.
    </p>
    <p style="font-style:normal; font-family:var(--mono); font-size:0.85rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--tiffany-dark); margin-top:8px;">
      Move. Explore. Connect. Grow.
    </p>
  </section>

  <section style="padding-top:0; padding-bottom:20px;">
    <div class="mission-gallery">
      {igPhotos.map((p) => (
        <div class="photo">
          <img src={p.image} alt={p.alt} />
        </div>
      ))}
    </div>
    <p style="text-align:center; color:var(--forest-3); font-family:var(--mono); font-size:0.78rem; letter-spacing:0.05em; text-transform:uppercase; margin-top:20px;">
      This is what a normal weekend looks like for us
    </p>
  </section>

  <section style="padding-top:20px;">
    <div class="retreats-page-head">
      <div class="eyebrow">What we believe</div>
      <p>Four things guide every hike we lead and every retreat we plan.</p>
    </div>
    <div class="values-grid">
      {values.map((v) => (
        <div class="value-card">
          <svg class="icon" viewBox="0 0 24 24" fill="none"><path d={v.icon} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="stats-band">
    <div class="photo">
      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/Na_Pali_Coast,_Kauai,_Hawaii.jpg?width=1800"
        alt="Dramatic Hawaiian coastline"
      />
    </div>
    <div class="stats-band-content">
      <div class="eyebrow" style="justify-content:center; margin-bottom:24px;">The numbers so far</div>
      <div class="mission-stats">
        <div><b>15,000+</b><span>hikers</span></div>
        <div><b>300+</b><span>hikes led</span></div>
        <div><b>70+</b><span>retreats hosted</span></div>
      </div>
    </div>
  </section>

  <section style="text-align:center;">
    <h2 style="color:var(--forest); font-size:clamp(1.8rem,3.4vw,2.4rem); margin-bottom:20px;">
      Come see for yourself
    </h2>
    <p style="color:var(--forest-3); max-width:520px; margin:0 auto 32px;">
      The easiest way to understand LAC is to show up to a hike. No sign-up, no gear list — just
      a trail and a group who'll probably know your name by the end of it.
    </p>
    <div class="hero-ctas" style="justify-content:center;">
      <a class="btn btn-ghost-dark" href="/hikes">See this week's hike</a>
      <a class="btn btn-solid" href="/retreats">Explore retreats</a>
    </div>
  </section>

  <CommunitySignup />
  <Footer />
</Layout>
