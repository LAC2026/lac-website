---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { retreats } from '../../../data/retreats';

export function getStaticPaths() {
  return retreats.map((retreat) => ({
    params: { slug: retreat.slug },
    props: { retreat },
  }));
}

const { retreat: r } = Astro.props;
---
<Layout
  title={`Reserve — ${r.name} — LA Activity Club`}
  description={`Reserve your spot on the ${r.name} retreat.`}
>
  <Header />

  <section class="page-hero" style="height:40vh; min-height:300px;">
    <div class="photo">
      <img src={r.heroImage} alt={r.heroImageAlt} />
    </div>
    <div class="page-hero-content">
      <div class="breadcrumb">
        <a href="/">Home</a> / <a href="/retreats">Retreats</a> / <a href={`/retreats#${r.slug}`}>{r.name}</a> / Reserve
      </div>
      <h1>Reserve your spot</h1>
    </div>
  </section>

  <section>
    <div class="reserve-page-grid">
      <div>
        <h2 style="color:var(--forest); margin-bottom:8px; font-size:1.6rem;">{r.name}</h2>
        <p style="color:var(--forest-3); margin-bottom:32px;">{r.fullDates} &middot; {r.groupSize}</p>

        <div id="reserveCanceled" class="reserve-confirm" hidden style="border-left-color:var(--gold);">
          <p>Checkout was canceled &mdash; no charge was made. You can try again whenever you're ready.</p>
        </div>

        <div id="reserveSuccess" class="reserve-confirm" hidden>
          <p>
            <strong>You're in!</strong> Your deposit went through and your spot is reserved.
            A confirmation was sent to your email. We'll be in touch with next steps.
          </p>
        </div>

        <form id="reserveForm" class="reserve-form" data-slug={r.slug}>
          <label>
            Full name
            <input type="text" name="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" required />
          </label>
          <label>
            Phone
            <input type="tel" name="phone" required />
          </label>
          <label>
            Gender <span style="font-weight:400; opacity:0.7;">(for accommodation planning)</span>
            <select name="gender" required>
              <option value="" disabled selected>Select one</option>
              <option value="female">Female</option>
              <option value="male">Male</option>
            </select>
          </label>
          <label>
            Number of spots
            <select name="spots">
              <option>1</option>
              <option>2</option>
              <option>3</option>
              <option>4</option>
            </select>
          </label>
          <label>
            Anything we should know?
            <textarea name="notes" rows="3"></textarea>
          </label>
          <button class="btn btn-solid" type="submit" id="reserveSubmitBtn">Continue to deposit payment</button>
          <p id="reserveError" class="reserve-error" hidden>
            Something went wrong. Please try again, or email
            <a href="mailto:team@laactivityclub.com">team@laactivityclub.com</a> directly.
          </p>
        </form>
      </div>

      <div class="reserve-card">
        <div class="row"><span>Deposit due today</span><span>{r.depositFrom}</span></div>
        <div class="row"><span>Total trip cost</span><span>{r.totalFrom}</span></div>
        <div class="row"><span>Balance due</span><span>1 week before trip</span></div>
        <p class="note">Deposit is refundable up to 20 days before departure.</p>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    const form = document.getElementById('reserveForm') as HTMLFormElement | null;
    const errorBox = document.getElementById('reserveError');
    const submitBtn = document.getElementById('reserveSubmitBtn') as HTMLButtonElement | null;

    // Show a message if we just got redirected back from Stripe
    const params = new URLSearchParams(location.search);
    if (params.get('success') === 'true') {
      document.getElementById('reserveSuccess')?.removeAttribute('hidden');
      form?.setAttribute('hidden', 'true');
    } else if (params.get('canceled') === 'true') {
      document.getElementById('reserveCanceled')?.removeAttribute('hidden');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.hidden = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Redirecting to payment...';
      }

      const formData = new FormData(form);
      const payload = {
        slug: form.dataset.slug,
        name: formData.get('name'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        gender: formData.get('gender'),
        spots: formData.get('spots'),
        notes: formData.get('notes'),
      };

      try {
        const res = await fetch('/api/create-checkout-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          throw new Error(data.error || 'No checkout URL returned');
        }
      } catch (err) {
        console.error(err);
        if (errorBox) errorBox.hidden = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Continue to deposit payment';
        }
      }
    });
  </script>
</Layout>
