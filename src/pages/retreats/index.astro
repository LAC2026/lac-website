---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RetreatFullDetail from '../../components/RetreatFullDetail.astro';
import { retreats } from '../../data/retreats';
---
<Layout
  title="Upcoming Retreats — LA Activity Club"
  description="The full calendar of upcoming LA Activity Club retreats — villas, trails, and a group to share it with."
>
  <Header />

  <section class="page-hero">
    <div class="photo">
      <img
        src="https://commons.wikimedia.org/wiki/Special:FilePath/Sedona_Red_Rocks_from_I-17.jpg?width=1800"
        alt="Red rock formations near Sedona, Arizona"
      />
    </div>
    <div class="page-hero-content">
      <div class="breadcrumb"><a href="/">Home</a> / Retreats</div>
      <h1>Upcoming retreats</h1>
    </div>
  </section>

  <section style="padding-bottom:40px;">
    <div class="retreats-page-head">
      <div class="eyebrow">The full calendar</div>
      <p>
        Multi-day escapes, fully planned. We handle the villa, the itinerary, and the group —
        you handle showing up. Every retreat includes a refundable deposit to hold your spot,
        with the balance due 1 week before departure.
      </p>
      <p style="margin-top:14px;">
        <a class="link" style="font-family:var(--mono); font-size:0.8rem; color:var(--tiffany); border-bottom:1px solid rgba(79,184,172,0.4); padding-bottom:3px;" href="/retreats/past">
          See where we've already been &rarr;
        </a>
      </p>
    </div>
  </section>

  {retreats.map((r) => <RetreatFullDetail retreat={r} />)}

  <Footer />
</Layout>
