# Copy this file to .env for local testing (astro dev) - .env is gitignored so it never gets committed.
# Real values go into Vercel's dashboard under Environments > Production, never in this file.

# Stripe secret key (test mode key starts with sk_test_, live key starts with sk_live_)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe webhook signing secret (from Stripe Dashboard > Developers > Webhooks > your endpoint)
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Resend API key (from resend.com dashboard > API Keys) - used to send notification emails to team@
RESEND_API_KEY=re_your_key_here

# Vercel Postgres connection - added automatically when you create a Postgres database
# in the Vercel dashboard and connect it to this project. You don't need to set this by hand.
# POSTGRES_URL=...
